# ── Build artifacts ───────────────────────────────────────────
/target
firmware/*/target

# Local CI / buildx cache (created by dev/ci.sh docker-smoke)
.cache/

# Generated release artifacts
dist/
release-assets/

# Nix build output symlinks (flake.nix)
result
result-*

# ESP32 build cache (esp-idf-sys managed)
.embuild/

# ── Local databases ───────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
# Numeric SQLite files (no .db extension)
[0-9]
[0-9]-shm
[0-9]-wal

# ── Environment files (may contain secrets) ───────────────────
.env
.env.local
.env.*.local

# ── Secret keys and credentials ───────────────────────────────
.secret_key
*.key
*.pem
credentials.json

# ── Dependencies and tool caches ──────────────────────────────
node_modules/
__pycache__/
*.pyc
.venv/
venv/
# direnv (.envrc uses `use flake`)
.direnv/

# ── Local scratch and machine-specific files ──────────────────
# Shared agent workspace mounted into the dev containers (created by dev/cli.sh)
playground/
# Git worktrees created per CLAUDE.md §6.2
.worktrees/
.wt-*/
.tmp_*
.local-tools/
build_release.sh
docker-compose.override.yml

# ── OS / editor noise ─────────────────────────────────────────
.DS_Store
._*
